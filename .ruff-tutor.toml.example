# Ruff Tutor MCP 設定ファイル
# このファイルを `.ruff-tutor.toml` にリネームして、プロジェクトルートに置いてください。

# 学習モード
# - "auto":     解説を表示した後、AI が自動修正する（デフォルト）
# - "beginner": 修正前/修正後のコード例と解説を見ながら、ユーザー自身が修正する
# - "advanced": 解説のみを見て、修正方法はユーザー自身が考える
mode = "auto"

# 学習セッション（beginner / advanced）での最大挑戦回数 (1-10)
# この回数まで修正に挑戦しても違反が残っている場合、正解が開示される
max_retry = 2
